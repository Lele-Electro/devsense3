{
  "name": "devsense",
  "description": "The official website for DevSense (Pty) Ltd a Pretoria based Software Development Agency & Consultancy",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production,github-pages && npm run prepare:pages",
    "prepare:pages": "node scripts/prepare-github-pages.mjs",
    "typecheck": "tsc --project tsconfig.spec.json --noEmit",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "build:ssr": "ng build devsense && npm run build:server:dev",
    "build:prod:ssr": "ng build devsense --configuration production && npm run build:server:prod",
    "build:server:dev": "tsc --project tsconfig.server.json",
    "build:server:prod": "tsc --project tsconfig.server.json",
    "serve:ssr": "node dist/devsense/browser/server/server.mjs",
    "serve:ssr:devsense3": "node dist/devsense/browser/server/server.mjs",
    "prerender": "npm run build:prod:ssr && npm run prerender:routes",
    "prerender:routes": "tsx prerender.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.2",
    "@angular/common": "^21.1.2",
    "@angular/compiler": "^21.1.2",
    "@angular/core": "^21.1.2",
    "@angular/forms": "^21.1.2",
    "@angular/platform-browser": "^21.1.2",
    "@angular/platform-browser-dynamic": "^21.1.2",
    "@angular/platform-server": "^21.1.2",
    "@angular/router": "^21.1.2",
    "@angular/ssr": "^21.1.2",
    "@fontsource/oxanium": "^5.3.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "intl-tel-input": "^19.5.7",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.12.36",
    "mjml": "5.1.0",
    "ngx-intl-tel-input": "^17.0.0",
    "nodemailer": "^8.0.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "~21.1.2",
    "@angular/compiler-cli": "^21.1.2",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/mjml": "^4.7.4",
    "@types/node": "^25.2.2",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "less": "^4.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
