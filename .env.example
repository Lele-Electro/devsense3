# Server Configuration
PORT=4000

# Brand/Organization Details
BRAND_NAME=DevSense
WEBSITE_URL=https://devsense.co.za
CONTACT_TO=contact@devsense.co.za

# SMTP Configuration (required for email sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="DevSense" <no-reply@devsense.co.za>

# Note: Without SMTP_HOST, emails will be rendered but not sent (dev mode)
