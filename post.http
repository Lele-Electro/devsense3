# Requires the VS Code REST Client extension. Keep credentials in a local .env file.
# WP_API_URL must be the REST API root, for example: https://example.com/wp-json/wp/v2
@apiUrl = {{$dotenv WP_API_URL}}
@wpUsername = {{$dotenv WP_USERNAME}}
@wpAppPassword = {{$dotenv WP_APP_PASSWORD}}
@auth = Basic {{wpUsername}}:{{wpAppPassword}}

# Set these after creating or locating the resources to edit.
@postId = 1
@categoryId = 1

### Create the Homepage category
POST {{apiUrl}}/categories
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "name": "Homepage",
  "slug": "homepage",
  "description": "Content used by visible sections of the active Devsense homepage."
}

### Create homepage hero
# Set categoryId to the Homepage category returned above before running.
POST {{apiUrl}}/posts
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "Software for the systems your business cannot afford to lose.",
  "slug": "home-hero",
  "content": "<p>Now live - Devsense AI &amp; Tech-BPO</p><p>Book a discovery call</p>",
  "excerpt": "A Pretoria engineering partner for financial services, retail and the public sector. We design, build and run the platforms your operations depend on - then keep them intelligent and staffed through our AI and Tech-BPO divisions.",
  "status": "publish",
  "categories": [{{categoryId}}]
}

### Create homepage AI hero slide
# Set categoryId to Homepage and featuredMediaId to the uploaded slide image before running.
@featuredMediaId = 0
POST {{apiUrl}}/posts
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "AI that survives contact with your business",
  "slug": "home-hero-ai",
  "content": "<p>AI engineering &amp; AI-as-a-Service</p><p>Explore AI at Devsense</p>",
  "excerpt": "We build AI into the processes that actually cost you money, measure whether it works, and then run it.",
  "status": "publish",
  "categories": [{{categoryId}}],
  "featured_media": {{featuredMediaId}}
}

### Verify credentials and API access
GET {{apiUrl}}/users/me?context=edit
Authorization: {{auth}}
Accept: application/json

### List posts, including drafts and private posts visible to this user
GET {{apiUrl}}/posts?context=edit&per_page=20&page=1&orderby=date&order=desc
Authorization: {{auth}}
Accept: application/json

### Get one post for editing
GET {{apiUrl}}/posts/{{postId}}?context=edit
Authorization: {{auth}}
Accept: application/json

### Create a draft post
# Replace the title, content, excerpt, categories, and featured_media values with extracted document data.
POST {{apiUrl}}/posts
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "Draft post title",
  "content": "<p>Draft content extracted from a source document.</p>",
  "excerpt": "A concise summary for listings and search results.",
  "status": "draft",
  "categories": [{{categoryId}}],
  "featured_media": 0
}

### Create service 1: Custom software engineering
POST {{apiUrl}}/posts
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "Custom Software Engineering",
  "content": "<p>Bespoke enterprise systems built around how your business actually works - not around the limits of an off-the-shelf package you are still paying to customise.</p><p>A national insurer needs claims assessors to work from a single queue instead of four systems and a spreadsheet. We map the process, model the data, build the platform and integrate the legacy policy admin system behind it.</p><h2>What this includes</h2><ul><li>Enterprise line-of-business applications</li><li>CRM, ERP and workflow platforms</li><li>API design, integration and middleware</li><li>Legacy modernisation and re-platforming</li><li>Process automation and internal tooling</li></ul>",
  "excerpt": "Bespoke enterprise systems built around how your business actually works.",
  "status": "draft",
  "categories": [4],
  "featured_media": 0,
  "acf": {
    "number": 1,
    "fa_icon": "fa fa-code"
  }
}

### Create service 2: SaaS product development
POST {{apiUrl}}/posts
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "SaaS Product Development",
  "content": "<p>Turning a proposition into a product people pay a subscription for - including all the unglamorous machinery that decides whether it is a business or a demo.</p><p>We build the first commercial version, instrument it so you can see which features drive retention, and structure the codebase so a second engineering team can be added without a rewrite.</p><h2>What this includes</h2><ul><li>Multi-tenant architecture and tenant isolation</li><li>Subscription billing, metering and entitlements</li><li>Self-service onboarding and trial flows</li><li>Product analytics, telemetry and churn signals</li><li>Role-based access, audit logging and SSO</li></ul>",
  "excerpt": "Subscription products engineered for commercial scale and sustainable growth.",
  "status": "draft",
  "categories": [4],
  "featured_media": 0,
  "acf": {
    "number": 2,
    "fa_icon": "fa fa-cubes"
  }
}

### Create service 3: Web application development
POST {{apiUrl}}/posts
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "Web Application Development",
  "content": "<p>Responsive, accessible web platforms that hold up under real transaction volume - and keep holding up when your traffic triples.</p><p>Performance budgets, automated Lighthouse checks and load testing are part of the delivery, not an optional extra quoted afterwards.</p><h2>What this includes</h2><ul><li>React, Next.js and Angular front ends</li><li>Server-side rendering and edge delivery</li><li>Design-system-driven component libraries</li><li>WCAG-conscious, keyboard-navigable interfaces</li><li>Headless CMS with hardened REST APIs</li></ul>",
  "excerpt": "Responsive, accessible web platforms engineered for real transaction volume.",
  "status": "draft",
  "categories": [4],
  "featured_media": 0,
  "acf": {
    "number": 3,
    "fa_icon": "fa fa-globe"
  }
}

### Create service 4: Mobile application development
POST {{apiUrl}}/posts
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "Mobile Application Development",
  "content": "<p>Native and cross-platform apps for iOS and Android, designed for the conditions your users are actually in - including no signal.</p><p>For field teams in mining and logistics, offline capability is the requirement, not a nice-to-have. We design the sync model before the screens.</p><h2>What this includes</h2><ul><li>Swift and Kotlin native development</li><li>Flutter and React Native cross-platform builds</li><li>Offline-first sync and conflict resolution</li><li>Push notification and deep-link architecture</li><li>App Store and Play Store release management</li></ul>",
  "excerpt": "Native and cross-platform apps designed for real-world operating conditions.",
  "status": "draft",
  "categories": [4],
  "featured_media": 0,
  "acf": {
    "number": 4,
    "fa_icon": "fa fa-mobile"
  }
}

### Create service 5: Cloud, hosting and DevOps
POST {{apiUrl}}/posts
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "Cloud, Hosting & DevOps",
  "content": "<p>Infrastructure you can reason about: reproducible, monitored, and cheap enough that nobody is afraid to spin up a staging environment.</p><p>All three major providers run South African regions, so data can stay in-country where POPIA or a tender requires it - while international clients deploy into EU or UK regions.</p><h2>What this includes</h2><ul><li>AWS, Microsoft Azure and Google Cloud</li><li>Containerised deployment with Docker and Kubernetes</li><li>CI/CD pipelines and infrastructure-as-code</li><li>Managed application and business email hosting</li><li>Observability, alerting and disaster recovery</li></ul>",
  "excerpt": "Reproducible, monitored cloud infrastructure and dependable application operations.",
  "status": "draft",
  "categories": [4],
  "featured_media": 0,
  "acf": {
    "number": 5,
    "fa_icon": "fa fa-cloud"
  }
}

### Create service 6: Data and database architecture
POST {{apiUrl}}/posts
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "Data & Database Architecture",
  "content": "<p>The layer everything else depends on. Modelled properly at the start, it is invisible; modelled badly, it is the reason the rewrite gets quoted three years later.</p><p>Database design and administration is one of our deepest competencies - across SQL, NoSQL and event-driven models.</p><h2>What this includes</h2><ul><li>Relational design on PostgreSQL and MySQL</li><li>Document and NoSQL stores - MongoDB, Cosmos DB, Firebase</li><li>Event-driven and streaming architectures</li><li>Reporting layers, warehousing and BI feeds</li><li>Migration, cleansing and de-duplication</li></ul>",
  "excerpt": "Database architecture and administration across SQL, NoSQL and event-driven models.",
  "status": "draft",
  "categories": [4],
  "featured_media": 0,
  "acf": {
    "number": 6,
    "fa_icon": "fa fa-database"
  }
}

### Create service 7: AI integration and automation
POST {{apiUrl}}/posts
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "AI Integration & Automation",
  "content": "<p>Practical AI applied to a specific, measurable job. No pilots that never leave the innovation team.</p><p>We start from the process that is costing you hours, not from the model. If a rules engine solves it more cheaply and predictably, we will tell you so.</p><h2>What this includes</h2><ul><li>Assistants grounded in your own documents</li><li>Document extraction and intelligent data capture</li><li>Forecasting, scoring and anomaly detection</li><li>Workflow automation with a human in the loop</li><li>Evaluation harnesses so quality is measurable</li></ul>",
  "excerpt": "Practical AI and automation applied to specific, measurable business work.",
  "status": "draft",
  "categories": [4],
  "featured_media": 0,
  "acf": {
    "number": 7,
    "fa_icon": "fa fa-magic"
  }
}

### Create service 8: UI/UX design and digital strategy
POST {{apiUrl}}/posts
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "UI/UX Design & Digital Strategy",
  "content": "<p>Research, interface design and the transformation roadmap that turns a backlog of requests into a sequenced plan your board can sign off.</p><p>Every engagement can start with a paid discovery sprint. You keep the architecture, scope and costed options whether or not you build with us.</p><h2>What this includes</h2><ul><li>Discovery workshops and stakeholder interviews</li><li>Journey mapping and information architecture</li><li>Interface design and design systems</li><li>Usability testing and accessibility review</li><li>Technology roadmaps and build-versus-buy analysis</li></ul>",
  "excerpt": "Research, interface design and a transformation roadmap that makes delivery decisions clear.",
  "status": "draft",
  "categories": [4],
  "featured_media": 0,
  "acf": {
    "number": 8,
    "fa_icon": "fa fa-pencil"
  }
}

### Update a post
POST {{apiUrl}}/posts/{{postId}}
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "Updated post title",
  "content": "<p>Updated content.</p>",
  "excerpt": "Updated excerpt.",
  "status": "draft"
}

### Publish a post
POST {{apiUrl}}/posts/{{postId}}
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "status": "publish"
}

### Move a post to the WordPress trash (recoverable)
DELETE {{apiUrl}}/posts/{{postId}}
Authorization: {{auth}}
Accept: application/json

### Permanently delete a trashed post (irreversible)
DELETE {{apiUrl}}/posts/{{postId}}?force=true
Authorization: {{auth}}
Accept: application/json

### List categories to find IDs for post payloads
GET {{apiUrl}}/categories?context=edit&per_page=100&orderby=name&order=asc
Authorization: {{auth}}
Accept: application/json

### Create a category
POST {{apiUrl}}/categories
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "name": "New category",
  "description": ""
}

### Upload a featured image or document asset
# Replace the file path and MIME type. Run this request before assigning its returned id to featured_media.
POST {{apiUrl}}/media
Authorization: {{auth}}
Content-Disposition: attachment; filename="source-image.jpg"
Content-Type: image/jpeg
Accept: application/json

< ./path/to/source-image.jpg

### Create the Our Process category
POST {{apiUrl}}/categories
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "name": "Our Process",
  "slug": "our-process",
  "description": "The four stages used to launch and run a Devsense Tech-BPO team."
}

### Our Process resource IDs
# Set these values from the category and media responses before creating the posts.
@ourProcessCategoryId = 13
@scopeProcessMediaId = 283
@teamOnboardingMediaId = 291
@shadowPilotMediaId = 287
@liveReportingMediaId = 289
@happyClientMediaId = 292

### Upload Our Process image 1: Scope and process capture
POST {{apiUrl}}/media
Authorization: {{auth}}
Content-Disposition: attachment; filename="scope-process-capture.jpg"
Content-Type: image/jpeg
Accept: application/json

< ./src/assets/images/our-process/scope-process-capture.jpg

### Add metadata to Our Process image 1
POST {{apiUrl}}/media/{{scopeProcessMediaId}}
Authorization: {{auth}}
Content-Type: application/json
Accept: application/json

{
  "title": "Scope and process capture",
  "alt_text": "A team member mapping a process with notes on a workshop table",
  "caption": "Photo by Brands&People on Unsplash",
  "description": "Source: https://unsplash.com/photos/Ax8IA8GAjVg. Free to use under the Unsplash License."
}

