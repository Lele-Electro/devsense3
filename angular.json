{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "anih": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/anih"
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/assets/css/bootstrap.min.scss",
              "src/assets/css/fontawesome/css/font-awesome.min.scss",
              "src/assets/css/owl.carousel.min.scss",
              "src/assets/css/magnific-popup.min.scss",
              "src/assets/css/loader.min.scss",
              "src/assets/css/flaticon.min.scss",
              "src/assets/css/lc_lightbox.scss",
              "src/assets/css/magic-mouse.scss",
              "src/assets/css/swiper-bundle.min.scss",
              "src/assets/css/style.scss",
              {
                "input": "src/assets/css/skin/skin-1.scss",
                "bundleName": "skin-1",
                "inject": false
              },
              {
                "input": "src/assets/css/skin/skin-2.scss",
                "bundleName": "skin-2",
                "inject": false
              },
              {
                "input": "src/assets/css/skin/skin-3.scss",
                "bundleName": "skin-3",
                "inject": false
              },
              {
                "input": "src/assets/css/skin/skin-4.scss",
                "bundleName": "skin-4",
                "inject": false
              },
              {
                "input": "src/assets/css/skin/skin-5.scss",
                "bundleName": "skin-5",
                "inject": false
              },
              {
                "input": "src/assets/css/skin/skin-6.scss",
                "bundleName": "skin-6",
                "inject": false
              },
              {
                "input": "src/assets/css/skin/skin-7.scss",
                "bundleName": "skin-7",
                "inject": false
              },
              {
                "input": "src/assets/css/skin/skin-8.scss",
                "bundleName": "skin-8",
                "inject": false
              },
              {
                "input": "src/assets/css/skin/skin-9.scss",
                "bundleName": "skin-7",
                "inject": false
              },
              {
                "input": "src/assets/css/skin/skin-10.scss",
                "bundleName": "skin-8",
                "inject": false
              }
            ],
            "scripts": [
              "src/assets/js/jquery-3.6.0.min.js",
              "src/assets/js/popper.min.js",
              "src/assets/js/bootstrap.min.js",
              "src/assets/js/magnific-popup.min.js",
              "src/assets/js/waypoints.min.js",
              "src/assets/js/counterup.min.js",
              "src/assets/js/waypoints-sticky.min.js",
              "src/assets/js/isotope.pkgd.min.js",
              "src/assets/js/imagesloaded.pkgd.min.js",
              "src/assets/js/owl.carousel.min.js",
              "src/assets/js/jquery.owl-filter.js",
              "src/assets/js/theia-sticky-sidebar.js",
              "src/assets/js/lc_lightbox.lite.js",
              "src/assets/js/magic_mouse.js",
              "src/assets/js/swiper-bundle.min.js",
              "src/assets/js/custom.js"
            ],
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "anih:build:production"
            },
            "development": {
              "buildTarget": "anih:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "anih:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "c8f8cee7-67b0-4a20-937e-f0336a5c71ce"
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}